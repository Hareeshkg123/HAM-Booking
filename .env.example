# Copy this file to .env and fill in values. Do NOT commit your real .env to git.
# Example .env
 
# Django
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
PASSWORD_RESET_DOMAIN=127.0.0.1:8000
PASSWORD_RESET_PROTOCOL=http
 
# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here

# Stripe (use test keys during development)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
